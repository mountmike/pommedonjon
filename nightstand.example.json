{
  "backupRoot": "/backups",
  "stateDir": "/state",
  "pollIntervalSeconds": 120,
  "headsUpLeadSeconds": 5,
  "snapshots": { "strategy": "none", "keep": 7 },
  "defaultPolicy": {
    "minIntervalHours": 20,
    "window": { "start": "18:00", "end": "22:30" },
    "requireExternalPower": true,
    "minBatteryPercent": 50,
    "maxUnansweredPromptsPerDay": 2,
    "retryAfterMinutes": 60,
    "staleAfterHours": 72
  },
  "devices": [
    {
      "id": "phone-one",
      "name": "First iPhone",
      "udid": "00000000-0000000000000000",
      "host": "192.0.2.10",
      "pairRecordPath": "pair-records/00000000-0000000000000000.plist"
    },
    {
      "id": "phone-two",
      "name": "Second iPhone",
      "udid": "00000000-0000000000000001",
      "host": "192.0.2.11",
      "pairRecordPath": "pair-records/00000000-0000000000000001.plist",
      "policy": { "window": { "start": "19:00", "end": "21:30" } }
    }
  ]
}
