{
  "name": "nightstand",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hosted, encrypted, restorable iPhone backups to a NAS.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "nightstand": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
