{
  "name": "pommedonjon-workspace",
  "private": true,
  "description": "The pommedonjon monorepo. The product's version lives in apps/server.",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "changeset": "changeset",
    "release:version": "changeset version",
    "dev": "docker compose -f compose.dev.yaml run --rm --build pommedonjon",
    "deploy:test": "node tools/deploy/src/deploy-test.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3"
  }
}
