{
  "name": "@pommedonjon/app",
  "version": "0.0.0",
  "private": true,
  "description": "The pommedonjon app: one codebase for the web and the iPhone.",
  "license": "GPL-3.0-only",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "ios": "expo run:ios",
