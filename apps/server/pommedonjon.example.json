{
  "backupRoot": "/backups",
  "stateDir": "/state",
  "pollIntervalSeconds": 120,
  "discovery": {
    "ranges": ["192.0.2.0/24"],
    "scanIntervalSeconds": 300
  },
  "defaultPolicy": {
    "dueAfterHours": 20,
    "automatic": true,
    "startWhenPluggedIn": true,
    "pluggedInWindowMinutes": 30,
    "startWhenUnlockedAfterHours": 4,
    "startOnChargerAfterHours": 24,
    "window": null,
    "retryAfterTimeoutMinutes": 10,
    "maxUnansweredPerDay": 3,
    "retryAfterCancelMinutes": 240,
    "retryAfterFailureMinutes": 10,
    "staleAfterHours": 72
  },
  "devices": [
    {
      "id": "phone-one",
      "name": "First iPhone",
      "udid": "00000000-0000000000000000",
      "pairRecordPath": "/run/secrets/phone-one.plist"
    },
    {
      "id": "phone-two",
      "name": "Second iPhone",
      "udid": "00000000-0000000000000001",
      "pairRecordPath": "/run/secrets/phone-two.plist",
      "host": "192.0.2.11",
      "policy": { "startOnChargerAfterHours": 0, "window": { "start": "07:00", "end": "22:00" } }
    }
  ]
}
