{
  "name": "pommedonjon",
  "version": "0.2.0",
  "private": true,
  "description": "Self-hosted, encrypted, restorable iPhone backups to a NAS.",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "pommedonjon": "dist/cli.js"
  },
  "files": [
    "dist",
    "sidecar"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@pommedonjon/api-contract": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
