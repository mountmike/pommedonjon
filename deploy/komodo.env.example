# Copy to local/komodo.env (which git ignores) and fill in. `pnpm deploy:test`
# reads these from the environment first and from that file second.
#
# Create the key in Komodo under Settings -> API Keys. It needs permission to
# deploy the test stack and read its logs, and nothing else.
KOMODO_URL=https://komodo.example.ts.net
KOMODO_API_KEY=
KOMODO_API_SECRET=
